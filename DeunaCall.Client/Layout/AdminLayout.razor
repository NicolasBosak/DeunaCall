@namespace DeunaCall.Client.Layout
@inherits LayoutComponentBase
@inject NavigationManager NavManager
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<div class="admin-layout">
    <nav class="admin-sidebar">
        <div class="admin-sidebar-header">
            <img src="logo.png" alt="Deuna Call Logo" style="height: 36px;" />
            <span>Panel Admin</span>
        </div>
        <ul class="admin-nav">
            <li><a href="/admin/patients" class="admin-nav-link">👥 Pacientes</a></li>
            <li><a href="/admin/nurses" class="admin-nav-link">👩‍⚕️ Enfermeras</a></li>
            <li><a href="/admin/reports" class="admin-nav-link">📊 Reportes</a></li>
        </ul>
        <button class="btn-logout-admin" @onclick="Logout">
            <svg class="logout-icon" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span class="logout-text" style="margin-left: 0.5rem;">Cerrar Sesión</span>
        </button>
    </nav>

    <main class="admin-main">
        @Body
    </main>
</div>

@code {
    private async Task Logout()
    {
        await LocalStorage.RemoveItemAsync("authToken");
        NavManager.NavigateTo("/");
    }
}

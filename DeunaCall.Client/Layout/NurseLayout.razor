@namespace DeunaCall.Client.Layout
@inherits LayoutComponentBase
@inject NavigationManager NavManager
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<div class="dashboard-layout">
    <div class="topbar">
        <div style="display: flex; align-items: center; gap: 1rem;">
            <img src="logo.png" alt="Deuna Call Logo" style="height: 40px;" />
            <h2 style="margin: 0; margin-right: 2rem;">Monitor de Enfermería</h2>
            
            <nav style="display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center;">
                <a href="/nurse/dashboard" class="btn-nav">🚨 Alertas</a>
                <a href="/nurse/patients" class="btn-nav">👥 Pacientes</a>
            </nav>
        </div>
        <button class="btn-logout" @onclick="Logout">Cerrar Sesión</button>
    </div>
    
    <div class="dashboard-content">
        @Body
    </div>
</div>

@code {
    private async Task Logout()
    {
        await LocalStorage.RemoveItemAsync("authToken");
        NavManager.NavigateTo("/nurse/login");
    }
}

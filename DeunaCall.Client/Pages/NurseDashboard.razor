@page "/nurse/dashboard"
@layout DeunaCall.Client.Layout.NurseLayout
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject NavigationManager NavManager
@using DeunaCall.Shared.Models
@using Microsoft.AspNetCore.SignalR.Client
@using System.Threading
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (isLoading)
{
    <p>Cargando alarmas...</p>
}
else if (activeRequests == null || !activeRequests.Any())
{
    <div style="text-align: center; margin-top: 5rem; color: var(--deuna-beige-dark);">
        <h2>No hay emergencias activas.</h2>
        <p>Todo está tranquilo por ahora.</p>
    </div>
}
else
{
    <div class="alarms-grid">
        @foreach (var req in activeRequests)
        {
            <div class="alarm-card @(req.Type == RequestType.Emergency ? "emergency" : "")">
                <div class="alarm-header">
                    <span class="alarm-room">Habitación: @req.Patient?.RoomNumber</span>
                    <span class="alarm-time">@GetWaitTime(req.CreatedAt)</span>
                </div>
                <div class="alarm-type">
                    @GetTypeName(req.Type)
                </div>
                <div style="margin-bottom: 1rem; color: var(--deuna-brown);">
                    Estado: <strong>@GetStatusName(req.Status)</strong><br />
                    Paciente: @req.Patient?.Name
                </div>
                
                <div class="alarm-actions">
                    @if (req.Status == RequestStatus.Pending)
                    {
                        <button class="btn-attend" @onclick="() => UpdateStatus(req.Id, RequestStatus.InProcess)">Atender Llamado</button>
                    }
                    else if (req.Status == RequestStatus.InProcess)
                    {
                        <button class="btn-complete" @onclick="() => UpdateStatus(req.Id, RequestStatus.Attended)">Cerrar Llamado</button>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private List<CallRequest> activeRequests = new();
    private bool isLoading = true;
    private HubConnection? hubConnection;
    private string token = "";
    private PeriodicTimer? _timer;

    protected override async Task OnInitializedAsync()
    {
        var storedToken = await LocalStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrEmpty(storedToken))
        {
            NavManager.NavigateTo("/nurse/login");
            return;
        }
        
        token = storedToken;
        Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

        await LoadRequests();
        StartTimer();

        hubConnection = new HubConnectionBuilder()
            .WithUrl(NavManager.ToAbsoluteUri("/callHub"), options =>
            {
                options.AccessTokenProvider = () => Task.FromResult(token);
            })
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<CallRequest>("ReceiveNewCall", async (newRequest) =>
        {
            await JS.InvokeVoidAsync("playAlertSound");
            await LoadRequests();
            await InvokeAsync(StateHasChanged);
        });

        hubConnection.On<int, RequestStatus>("CallStatusChanged", async (requestId, newStatus) =>
        {
            await LoadRequests();
            await InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();
    }

    private async Task LoadRequests()
    {
        isLoading = true;
        try
        {
            var response = await Http.GetFromJsonAsync<List<CallRequest>>("api/requests");
            if (response != null)
            {
                activeRequests = response;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        isLoading = false;
        StateHasChanged();
    }

    private async Task UpdateStatus(int id, RequestStatus newStatus)
    {
        var response = await Http.PutAsJsonAsync($"api/requests/{id}/status", newStatus);
        if (response.IsSuccessStatusCode)
        {
            await LoadRequests();
        }
    }

    private string GetTypeName(RequestType type) => type switch
    {
        RequestType.Bathroom => "Baño",
        RequestType.Medication => "Medicación",
        RequestType.Mobilization => "Movilización",
        RequestType.Emergency => "EMERGENCIA",
        _ => type.ToString()
    };

    private string GetStatusName(RequestStatus status) => status switch
    {
        RequestStatus.Pending => "Pendiente de Atención",
        RequestStatus.InProcess => "En Camino",
        RequestStatus.Attended => "Solucionado",
        _ => status.ToString()
    };

    private string GetWaitTime(DateTime createdAt)
    {
        var diff = DateTime.UtcNow - createdAt;
        if (diff.TotalMinutes < 1) return "Menos de 1 min";
        return $"Hace {(int)diff.TotalMinutes} min";
    }

    private async void StartTimer()
    {
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(60));
        while (await _timer.WaitForNextTickAsync())
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}

@page "/nurse/patients"
@layout NurseLayout
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject NavigationManager NavManager
@using DeunaCall.Shared.Models
@using DeunaCall.Shared.DTOs

<div style="padding: 2rem; max-width: 1000px; margin: 0 auto; width: 100%; height: 100%; overflow-y: auto;">
    <h1 class="admin-title" style="margin-bottom: 2rem; font-size: 2.5rem; text-align: left;">Pacientes Activos</h1>

    <button class="btn-primary" style="margin-bottom: 2rem; font-size: 1.2rem; padding: 1rem 2rem; border-radius: 12px; width: auto;" @onclick="() => showForm = !showForm">
        @(showForm ? "✕ Cancelar" : "+ Admitir Nuevo Paciente")
    </button>

    @if (showForm)
    {
        <div class="admin-form-card" style="margin-bottom: 3rem;">
            <h3 style="margin-top:0;">Registro de Nuevo Paciente</h3>
            <input type="text" @bind="newPatient.Name" placeholder="Nombre del Paciente" class="admin-input" />
            <input type="text" @bind="newPatient.RoomNumber" placeholder="Número de Habitación" class="admin-input" />
            <button class="btn-admin-save" style="margin-top: 1rem;" @onclick="AdmitPatient">Crear Paciente y Generar Código</button>
        </div>
    }

    @if (patients == null)
    {
        <p>Cargando pacientes...</p>
    }
    else
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Habitación</th>
                    <th>Nombre</th>
                    <th>Código de Acceso</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in patients)
                {
                    <tr>
                        <td style="font-size: 1.5rem; font-weight: bold;">@p.RoomNumber</td>
                        <td>@p.Name</td>
                        <td><code style="font-size: 1.5rem; color: var(--deuna-red);">@p.AccessCode</code></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<Patient>? patients;
    private CreatePatientDto newPatient = new();
    private bool showForm = false;

    protected override async Task OnInitializedAsync()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrEmpty(token)) { NavManager.NavigateTo("/nurse/login"); return; }
        Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        await LoadPatients();
    }

    private async Task LoadPatients()
    {
        patients = await Http.GetFromJsonAsync<List<Patient>>("api/patients");
    }

    private async Task AdmitPatient()
    {
        var response = await Http.PostAsJsonAsync("api/patients/admit", newPatient);
        if (response.IsSuccessStatusCode)
        {
            newPatient = new();
            showForm = false;
            await LoadPatients();
        }
    }
}

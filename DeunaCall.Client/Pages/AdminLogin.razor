@page "/admin/login"
@layout KioskLayout
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject NavigationManager NavManager

<div class="login-container">
    <h2 style="color: var(--deuna-brown); margin-bottom: 2rem;">Acceso de Supervisor</h2>
    <input type="text" @bind="username" placeholder="Usuario" class="pin-input" style="letter-spacing: normal; font-size: 1.5rem;" />
    <input type="password" @bind="password" placeholder="Contraseña" class="pin-input" style="letter-spacing: normal; font-size: 1.5rem;" />
    
    <button class="btn-primary" @onclick="Login">INGRESAR</button>
    
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p style="color: var(--deuna-red); margin-top: 1rem; font-weight: bold;">@errorMessage</p>
    }

    <a href="/" style="margin-top: 2rem; color: var(--deuna-beige-dark); text-decoration: none; font-size: 1.1rem;">
        ← Volver a selección
    </a>
</div>

@code {
    private string username = "";
    private string password = "";
    private string errorMessage = "";

    private async Task Login()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", new { Username = username, Password = password });
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<DeunaCall.Shared.DTOs.AuthResponseDto>();
                if (result != null && result.Role == "SuperAdmin")
                {
                    await LocalStorage.SetItemAsync("authToken", result.Token);
                    NavManager.NavigateTo("/admin/patients");
                }
                else
                {
                    errorMessage = "No tiene permisos de supervisor.";
                }
            }
            else
            {
                errorMessage = "Credenciales incorrectas.";
            }
        }
        catch
        {
            errorMessage = "Error de conexión.";
        }
    }
}

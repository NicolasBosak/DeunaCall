@page "/board"
@layout DeunaCall.Client.Layout.KioskLayout
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject NavigationManager NavManager
@using DeunaCall.Shared.Models
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable

@if (isCalling)
{
    <DeunaCall.Client.Components.StatusModal StatusMessage="@statusMessage" StatusIcon="@statusIcon" />
}

<button class="btn-logout" style="position: absolute; top: 1.5rem; right: 1.5rem; background: var(--glass-bg); backdrop-filter: blur(5px); border: 1px solid var(--deuna-red); color: var(--deuna-red); padding: 0.8rem; border-radius: 12px; display: flex; align-items: center; gap: 0.5rem; cursor: pointer; transition: all 0.3s;" @onclick="Logout">
    <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
        <polyline points="16 17 21 12 16 7"></polyline>
        <line x1="21" y1="12" x2="9" y2="12"></line>
    </svg>
    <span class="logout-text-kiosk" style="font-weight: bold;">Salir</span>
</button>

<div class="call-grid">
    <button class="call-btn call-btn-normal" @onclick="() => RequestHelp(RequestType.Bathroom)">
        <svg viewBox="0 0 24 24"><path d="M7 19v2h2v-2h6v2h2v-2h1.5A1.5 1.5 0 0 0 20 17.5v-11A1.5 1.5 0 0 0 18.5 5h-13A1.5 1.5 0 0 0 4 6.5v11A1.5 1.5 0 0 0 5.5 19H7zM9 7h6v2H9V7zm0 4h6v2H9v-2z" /></svg>
        Baño
    </button>
    <button class="call-btn call-btn-normal" @onclick="() => RequestHelp(RequestType.Medication)">
        <svg viewBox="0 0 24 24"><path d="M17 19V5H7v14h10zM9 7h6v2H9V7zm0 4h6v2H9v-2zm0 4h6v2H9v-2z" /></svg>
        Medicación
    </button>
    <button class="call-btn call-btn-normal" @onclick="() => RequestHelp(RequestType.Mobilization)">
        <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" /></svg>
        Movilización
    </button>
    <button class="call-btn call-btn-emergency" @onclick="() => RequestHelp(RequestType.Emergency)">
        <svg viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" /></svg>
        EMERGENCIA
    </button>
</div>

@code {
    private bool isCalling = false;
    private string statusMessage = "";
    private string statusIcon = "bell";
    private HubConnection? hubConnection;

    protected override async Task OnInitializedAsync()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrEmpty(token))
        {
            NavManager.NavigateTo("/");
            return;
        }

        Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

        hubConnection = new HubConnectionBuilder()
            .WithUrl(NavManager.ToAbsoluteUri("/callHub"), options =>
            {
                options.AccessTokenProvider = () => Task.FromResult(token);
            })
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<int, RequestStatus>("CallStatusChanged", (requestId, newStatus) =>
        {
            if (newStatus == RequestStatus.InProcess)
            {
                statusMessage = "Enfermera en camino";
                statusIcon = "check";
                InvokeAsync(StateHasChanged);
            }
            else if (newStatus == RequestStatus.Attended)
            {
                isCalling = false;
                InvokeAsync(StateHasChanged);
            }
        });

        await hubConnection.StartAsync();
    }

    private async Task RequestHelp(RequestType type)
    {
        var request = new CallRequest { Type = type };
        var response = await Http.PostAsJsonAsync("api/requests", request);

        if (response.IsSuccessStatusCode)
        {
            isCalling = true;
            statusMessage = "Enviando alerta...";
            statusIcon = "bell";
            
            await Task.Delay(1000);
            if (statusMessage == "Enviando alerta...")
            {
                statusMessage = "Alerta Recibida. Esperando...";
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    private async Task Logout()
    {
        await LocalStorage.RemoveItemAsync("authToken");
        NavManager.NavigateTo("/");
    }
}
